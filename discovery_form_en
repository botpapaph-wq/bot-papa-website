  <!-- Supabase via CDN (v2) – placeholders, fill in URL & ANON KEY later -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const SUPABASE_URL = "https://YOUR-PROJECT-ID.supabase.co";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
    const SUPABASE_TABLE = "ai_discovery_forms_v1";

    let supabaseClient = null;
    if (SUPABASE_URL && SUPABASE_URL !== "https://YOUR-PROJECT-ID.supabase.co") {
      supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }

    function getCheckedValues(name) {
      return Array.from(document.querySelectorAll('input[name="' + name + '"]:checked'))
        .map(el => el.value);
    }

    function getRadioValue(name) {
      const el = document.querySelector('input[name="' + name + '"]:checked');
      return el ? el.value : null;
    }

    document.getElementById("discovery-form").addEventListener("submit", async function (e) {
      e.preventDefault();
      const statusEl = document.getElementById("status-message");

      if (!supabaseClient) {
        statusEl.textContent = "Supabase not configured yet. Please set URL and ANON KEY.";
        statusEl.classList.remove("status-success");
        statusEl.classList.add("status-error");
        return;
      }

      statusEl.textContent = "Submitting…";
      statusEl.classList.remove("status-error", "status-success");

      const form = e.target;
      const data = {
        // 0. Project Background
        reasons: getCheckedValues("reasons"),
        reason_other: form.reason_other.value || null,
        estimated_monthly_cost: form.estimated_monthly_cost.value || null,
        improvement_goal: form.improvement_goal.value || null,

        // 1. Company Information
        company_name: form.company_name.value || null,
        website: form.website.value || null,
        industry: form.industry.value || null,
        country: form.country.value || null,
        locations: form.locations.value || null,
        num_employees: form.num_employees.value || null,
        phone_contacts: form.phone_contacts.value || null,
        business_hours: form.business_hours.value || null,
        phone_country_code: form.phone_country_code.value || null,
        phone_number_customer: form.phone_number_customer.value || null,
        customer_email: form.customer_email.value || null,

        // 2. Project Stakeholders
        technical_contact: form.technical_contact.value || null,
        operational_contact: form.operational_contact.value || null,
        commercial_decision_maker: form.commercial_decision_maker.value || null,
        management_involved: getRadioValue("management_involved"),
        final_approval: form.final_approval.value || null,

        // 3. Current Telephony Setup
        current_phone_system: form.current_phone_system.value || null,
        telephony_elements: getCheckedValues("telephony_elements"),

        // 4. Call Volume
        avg_calls_per_day: form.avg_calls_per_day.value || null,
        avg_calls_per_week: form.avg_calls_per_week.value || null,
        peak_times: form.peak_times.value || null,
        missed_calls: form.missed_calls.value || null,
        seasonal_fluctuations: getRadioValue("seasonal_fluctuations"),
        seasonal_patterns: getCheckedValues("seasonal_patterns"),
        seasonal_other: form.seasonal_other.value || null,

        // 5. Target Picture
        ai_tasks: getCheckedValues("ai_tasks"),
        ai_not_do: form.ai_not_do.value || null,

        // 6. Top Customer Inquiries
        top_inquiries: form.top_inquiries.value || null,
        standard_answers_available: getRadioValue("standard_answers_available"),

        // 7. Escalation Logic
        escalation_triggers: getCheckedValues("escalation_triggers"),
        misunderstanding_loops: form.misunderstanding_loops.value || null,
        sales_escalation: form.sales_escalation.value || null,
        support_escalation: form.support_escalation.value || null,
        emergency_service: form.emergency_service.value || null,
        accounting: form.accounting.value || null,

        // 8. Data Collection
        required_fields: getCheckedValues("required_fields"),
        optional_fields: getCheckedValues("optional_fields"),

        // 9. Language & Pronunciation
        customer_languages: getCheckedValues("customer_languages"),
        primary_language: form.primary_language.value || null,
        secondary_language_required: getRadioValue("secondary_language_required"),
        secondary_language: form.secondary_language.value || null,
        accent_preference: getCheckedValues("accent_preference"),
        industry_terms: form.industry_terms.value || null,
        spelled_out_often: getRadioValue("spelled_out_often"),

        // 10. Knowledge Sources
        knowledge_priority_1: getCheckedValues("knowledge_priority_1"),
        knowledge_path_p1: form.knowledge_path_p1.value || null,
        knowledge_priority_2: form.knowledge_priority_2.value || null,
        knowledge_priority_3: form.knowledge_priority_3.value || null,

        // 11. Systems & Integrations
        systems_integrations: getCheckedValues("systems_integrations"),

        // 12. Compliance
        compliance: getCheckedValues("compliance"),
        compliance_notes: form.compliance_notes.value || null,

        // 13. Success Definition / ROI
        roi_fewer_missed_calls: form.roi_fewer_missed_calls.value || null,
        roi_more_leads: form.roi_more_leads.value || null,
        roi_hours_saved: form.roi_hours_saved.value || null,
        roi_money_saved: form.roi_money_saved.value || null,

        // 14. Process Restrictions
        process_restrictions: form.process_restrictions.value || null,

        submitted_at: new Date().toISOString()
      };

      try {
        const { error } = await supabaseClient
          .from(SUPABASE_TABLE)
          .insert([data]);

        if (error) {
          console.error(error);
          statusEl.textContent = "Error while submitting. Please try again or contact Bodo.";
          statusEl.classList.add("status-error");
        } else {
          statusEl.textContent = "Form submitted successfully. Thank you!";
          statusEl.classList.add("status-success");
          form.reset();
        }
      } catch (err) {
        console.error(err);
        statusEl.textContent = "Unexpected error. Please try again or send details via email.";
        statusEl.classList.add("status-error");
      }
    });
  </script>
