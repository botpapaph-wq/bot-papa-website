<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>BOT PAPA – AI Telephone Assistant Discovery Form</title>
  <meta name="description" content="Discovery form for AI telephone assistant projects with BOT PAPA. Collect structured requirements for AI-powered telephony, routing and automation." />

  <style>
    :root {
      --bg: #050816;
      --bg-soft: #0b1020;
      --accent: #00e0ff;
      --accent-soft: rgba(0, 224, 255, 0.12);
      --text: #f5f7ff;
      --muted: #a3aac2;
      --danger: #ff4b6b;
      --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.45);
      --radius-lg: 18px;
      --radius-full: 999px;
      --border-soft: 1px solid rgba(255, 255, 255, 0.07);
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
        "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: var(--font-sans);
      background: radial-gradient(circle at top, #101735 0, #050816 55%, #02030a 100%);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .page {
      max-width: 1120px;
      margin: 0 auto;
      padding: 24px 20px 64px;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 16px 12px;
      margin-bottom: 32px;
      border-radius: var(--radius-full);
      border: var(--border-soft);
      background: linear-gradient(135deg, rgba(0, 224, 255, 0.12), transparent);
      backdrop-filter: blur(16px);
      box-shadow: var(--shadow-soft);
      position: sticky;
      top: 16px;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .brand-mark {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }

    .brand-mark img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .brand-text-title {
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-size: 14px;
    }

    .brand-text-sub {
      font-size: 12px;
      color: var(--muted);
    }

    .header-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      flex: 1;
    }

    .header-top-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      width: 100%;
    }

    .pill {
      border-radius: var(--radius-full);
      padding: 6px 14px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border: var(--border-soft);
      color: var(--muted);
      background: rgba(5, 8, 22, 0.9);
      white-space: nowrap;
    }

    .btn-primary {
      border-radius: var(--radius-full);
      padding: 9px 18px;
      border: none;
      outline: none;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      background: linear-gradient(135deg, #00e0ff, #7b3fff);
      color: #050816;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }

    .btn-primary span {
      font-size: 16px;
      transform: translateY(1px);
    }

    .btn-primary:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .btn-primary:active {
      filter: brightness(0.98);
      transform: translateY(0);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.55);
    }

    main {
      margin-top: 12px;
    }

    .hero {
      padding: 26px 24px 20px;
      border-radius: var(--radius-lg);
      border: var(--border-soft);
      background: radial-gradient(circle at top left, rgba(0, 224, 255, 0.08), transparent 55%),
        linear-gradient(145deg, rgba(14, 21, 47, 0.95), rgba(3, 5, 16, 0.98));
      box-shadow: var(--shadow-soft);
      margin-bottom: 20px;
    }

    .hero-kicker {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin-bottom: 8px;
    }

    .hero-title {
      font-size: clamp(24px, 2.7vw, 30px);
      line-height: 1.15;
      margin: 0 0 10px;
    }

    .hero-sub {
      font-size: 14px;
      color: var(--muted);
      max-width: 640px;
      margin-bottom: 4px;
    }

    .form-card {
      margin-top: 20px;
      padding: 20px 18px 22px;
      border-radius: var(--radius-lg);
      border: var(--border-soft);
      background: linear-gradient(155deg, rgba(8, 13, 34, 0.95), rgba(2, 4, 13, 0.98));
      box-shadow: var(--shadow-soft);
      font-size: 14px;
    }

    h2.section-title {
      margin: 18px 0 8px;
      font-size: 18px;
    }

    .field-group {
      margin-bottom: 14px;
    }

    .field-label {
      display: block;
      font-size: 13px;
      margin-bottom: 4px;
      color: var(--text);
    }

    .field-help {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }

    input[type="text"],
    input[type="number"],
    input[type="email"],
    textarea,
    select {
      width: 100%;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(3, 6, 20, 0.96);
      color: var(--text);
      font-size: 13px;
      outline: none;
    }

    textarea {
      min-height: 70px;
      resize: vertical;
    }

    input::placeholder,
    textarea::placeholder {
      color: rgba(163, 170, 194, 0.7);
    }

    .checkbox-grid,
    .radio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 6px 18px;
      margin-top: 4px;
    }

    .checkbox-inline,
    .radio-inline {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--muted);
    }

    .inline-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      margin-top: 4px;
    }

    .inline-group .field-group {
      flex: 1;
      min-width: 180px;
      margin-bottom: 0;
    }

    .divider {
      margin: 18px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .tagline {
      font-size: 12px;
      color: var(--muted);
      margin-top: 4px;
    }

    .status-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 12px;
      color: var(--muted);
      margin-top: 16px;
      flex-wrap: wrap;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #20c997;
      margin-right: 6px;
    }

    .status-left {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .status-right {
      text-align: right;
    }

    .status-error {
      color: var(--danger);
    }

    .status-success {
      color: #20c997;
    }

    .submit-row {
      margin-top: 18px;
      display: flex;
      justify-content: flex-end;
    }

    footer {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 11px;
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: space-between;
    }

    @media (max-width: 768px) {
      header {
        position: static;
        border-radius: 14px;
        padding: 10px 12px;
      }
      .header-right {
        align-items: flex-start;
      }
      .header-top-row {
        justify-content: flex-start;
        flex-wrap: wrap;
        row-gap: 6px;
      }
      .hero {
        padding: 22px 18px 18px;
      }
      .status-right {
        text-align: left;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <div class="brand">
        <div class="brand-mark">
          <img src="BOT_PAPA-removebg.png" alt="BOT PAPA Logo" />
        </div>
        <div>
          <div class="brand-text-title">BOT PAPA</div>
          <div class="brand-text-sub">AI Phone Assistants for Small Businesses</div>
        </div>
      </div>
      <div class="header-right">
        <div class="header-top-row">
          <div class="pill">
            Discovery form • AI telephone assistant
          </div>
          <a href="index" class="btn-primary">
            Back to main site <span>↗</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-kicker">AI Telephone Assistant • Discovery Form v1.0</div>
        <h1 class="hero-title">
          Project discovery for your AI‑powered telephony setup.
        </h1>
        <p class="hero-sub">
          This form collects the key details about your current phone setup,
          call flows and constraints – so we can design an AI telephone assistant
          that fits your real‑world operations.
        </p>
      </section>

      <section class="form-card">
        <form id="discovery-form">
          <!-- 0. Project Background / Business Case -->
          <h2 class="section-title">0. Project Background / Business Case</h2>
          <div class="field-group">
            <span class="field-label">Why is the client exploring AI‑powered telephony right now?</span>
            <div class="checkbox-grid">
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="too_many_missed_calls" />
                Too many missed calls
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="staff_shortage" />
                Staff shortage
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="business_growth" />
                Business growth
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="need_24_7" />
                Need for 24/7 availability
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="high_support_workload" />
                High support workload
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="many_repetitive_inquiries" />
                Many repetitive inquiries
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="quality_issues_phone_service" />
                Quality issues in phone service
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="cost_reduction" />
                Cost reduction
              </label>
            </div>
          </div>

          <div class="field-group">
            <label for="reason_other" class="field-label">Other reason</label>
            <input type="text" id="reason_other" name="reason_other" placeholder="Other: short description" />
          </div>

          <div class="field-group">
            <label for="estimated_monthly_cost" class="field-label">Estimated monthly cost of the current problem</label>
            <input type="text" id="estimated_monthly_cost" name="estimated_monthly_cost" placeholder="Rough estimate in your currency" />
          </div>

          <div class="field-group">
            <label for="improvement_goal" class="field-label">What exactly should improve?</label>
            <textarea id="improvement_goal" name="improvement_goal" placeholder="Free text – describe the practical improvements you want to see."></textarea>
          </div>

          <div class="divider"></div>

          <!-- 1. Company Information -->
          <h2 class="section-title">1. Company Information</h2>
          <div class="field-group">
            <label for="company_name" class="field-label">Company name</label>
            <input type="text" id="company_name" name="company_name" />
          </div>

          <div class="inline-group">
            <div class="field-group">
              <label for="website" class="field-label">Website</label>
              <input type="text" id="website" name="website" />
            </div>
            <div class="field-group">
              <label for="industry" class="field-label">Industry</label>
              <input type="text" id="industry" name="industry" />
            </div>
          </div>

          <!-- Country selection (Europe excl. TR/UA/AL + English-speaking/PH) -->
          <div class="field-group">
            <label for="country" class="field-label">Country</label>
            <select id="country" name="country">
              <option value="">Select country…</option>
              <!-- Europe (some examples, ohne TR/UA/AL) -->
              <option value="DE">Germany</option>
              <option value="AT">Austria</option>
              <option value="CH">Switzerland</option>
              <option value="FR">France</option>
              <option value="IT">Italy</option>
              <option value="ES">Spain</option>
              <option value="PT">Portugal</option>
              <option value="NL">Netherlands</option>
              <option value="BE">Belgium</option>
              <option value="LU">Luxembourg</option>
              <option value="DK">Denmark</option>
              <option value="SE">Sweden</option>
              <option value="NO">Norway</option>
              <option value="FI">Finland</option>
              <option value="IS">Iceland</option>
              <option value="IE">Ireland</option>
              <option value="GB">United Kingdom</option>
              <option value="PL">Poland</option>
              <option value="CZ">Czech Republic</option>
              <option value="SK">Slovakia</option>
              <option value="HU">Hungary</option>
              <option value="SI">Slovenia</option>
              <option value="HR">Croatia</option>
              <option value="RS">Serbia</option>
              <option value="BA">Bosnia and Herzegovina</option>
              <option value="MK">North Macedonia</option>
              <option value="RO">Romania</option>
              <option value="BG">Bulgaria</option>
              <option value="GR">Greece</option>
              <option value="CY">Cyprus</option>
              <option value="MT">Malta</option>
              <option value="EE">Estonia</option>
              <option value="LV">Latvia</option>
              <option value="LT">Lithuania</option>

              <!-- English-speaking / English official or co-official + PH -->
              <option value="US">United States</option>
              <option value="CA">Canada</option>
              <option value="AU">Australia</option>
              <option value="NZ">New Zealand</option>
              <option value="ZA">South Africa</option>
              <option value="PH">Philippines</option>
              <option value="SG">Singapore</option>
              <option value="IN">India</option>
              <option value="PK">Pakistan</option>
              <option value="NG">Nigeria</option>
              <option value="GH">Ghana</option>
              <option value="KE">Kenya</option>
              <option value="TZ">Tanzania</option>
              <option value="UG">Uganda</option>
              <option value="ZW">Zimbabwe</option>
              <option value="JM">Jamaica</option>
              <option value="TT">Trinidad and Tobago</option>
              <option value="BB">Barbados</option>
              <option value="BS">Bahamas</option>
              <option value="BZ">Belize</option>
              <option value="FJ">Fiji</option>
              <option value="PG">Papua New Guinea</option>
            </select>
          </div>

          <div class="inline-group">
            <div class="field-group">
              <label for="locations" class="field-label">Locations (cities / regions)</label>
              <input type="text" id="locations" name="locations" />
            </div>
            <div class="field-group">
              <label for="num_employees" class="field-label">Number of employees</label>
              <input type="text" id="num_employees" name="num_employees" />
            </div>
          </div>

          <div class="inline-group">
            <div class="field-group">
              <label for="phone_contacts" class="field-label">Phone contacts</label>
              <input type="text" id="phone_contacts" name="phone_contacts" placeholder="How many people handle calls?" />
            </div>
            <div class="field-group">
              <label for="business_hours" class="field-label">Business hours</label>
              <input type="text" id="business_hours" name="business_hours" placeholder="e.g. Mon–Fri 8:00–17:00 local time" />
            </div>
          </div>

          <!-- Customer phone & email -->
          <div class="inline-group">
            <div class="field-group">
              <label for="phone_country_code" class="field-label">Customer phone country code</label>
              <select id="phone_country_code" name="phone_country_code">
                <option value="">Select code…</option>
                <option value="+49">+49 (Germany)</option>
                <option value="+43">+43 (Austria)</option>
                <option value="+41">+41 (Switzerland)</option>
                <option value="+33">+33 (France)</option>
                <option value="+39">+39 (Italy)</option>
                <option value="+34">+34 (Spain)</option>
                <option value="+351">+351 (Portugal)</option>
                <option value="+31">+31 (Netherlands)</option>
                <option value="+32">+32 (Belgium)</option>
                <option value="+44">+44 (United Kingdom)</option>
                <option value="+1">+1 (USA/Canada)</option>
                <option value="+61">+61 (Australia)</option>
                <option value="+64">+64 (New Zealand)</option>
                <option value="+27">+27 (South Africa)</option>
                <option value="+63">+63 (Philippines)</option>
                <option value="+65">+65 (Singapore)</option>
                <option value="+91">+91 (India)</option>
                <option value="+92">+92 (Pakistan)</option>
                <option value="+234">+234 (Nigeria)</option>
                <option value="+233">+233 (Ghana)</option>
                <option value="+254">+254 (Kenya)</option>
                <option value="+255">+255 (Tanzania)</option>
                <option value="+256">+256 (Uganda)</option>
              </select>
            </div>
            <div class="field-group">
              <label for="phone_number_customer" class="field-label">Customer phone number</label>
              <input type="text" id="phone_number_customer" name="phone_number_customer" placeholder="Local number without country code" />
            </div>
          </div>

          <div class="field-group">
            <label for="customer_email" class="field-label">Customer email</label>
            <input
              type="email"
              id="customer_email"
              name="customer_email"
              placeholder="name@company.com"
              pattern="^(?!info@).*"
              title="Please use a personal or role-specific email, not a generic info@ address."
            />
            <div class="field-help">
              Generic inboxes like <code>info@</code> are often not monitored closely. Please use a personal or role‑specific address.
            </div>
          </div>

          <div class="divider"></div>

          <!-- 2. Project Stakeholders -->
          <h2 class="section-title">2. Project Stakeholders</h2>
          <div class="field-group">
            <label for="technical_contact" class="field-label">Technical contact</label>
            <input type="text" id="technical_contact" name="technical_contact" placeholder="Name, role, email/phone if helpful" />
          </div>
          <div class="field-group">
            <label for="operational_contact" class="field-label">Operational contact</label>
            <input type="text" id="operational_contact" name="operational_contact" placeholder="Person responsible for day‑to‑day phone ops" />
          </div>
          <div class="field-group">
            <label for="commercial_decision_maker" class="field-label">Commercial decision maker</label>
            <input type="text" id="commercial_decision_maker" name="commercial_decision_maker" />
          </div>
          <div class="field-group">
            <span class="field-label">Is management involved?</span>
            <div class="inline-group">
              <label class="radio-inline">
                <input type="radio" name="management_involved" value="yes" />
                Yes
              </label>
              <label class="radio-inline">
                <input type="radio" name="management_involved" value="no" />
                No
              </label>
            </div>
          </div>
          <div class="field-group">
            <label for="final_approval" class="field-label">Who gives final approval?</label>
            <input type="text" id="final_approval" name="final_approval" />
          </div>

          <div class="divider"></div>

          <!-- 3. Current Telephony Setup -->
          <h2 class="section-title">3. Current Telephony Setup</h2>
          <div class="field-group">
            <label for="current_phone_system" class="field-label">Current phone system</label>
            <input type="text" id="current_phone_system" name="current_phone_system" placeholder="e.g. Telnyx, Placetel, other PBX" />
          </div>
          <div class="field-group">
            <span class="field-label">Existing elements</span>
            <div class="checkbox-grid">
              <label class="checkbox-inline">
                <input type="checkbox" name="telephony_elements" value="main_company_number" />
                Main company number exists
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="telephony_elements" value="extensions" />
                Extensions exist
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="telephony_elements" value="call_groups" />
                Call groups exist
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="telephony_elements" value="queues" />
                Queues / waiting loops exist
              </label>
            </div>
          </div>

          <div class="divider"></div>

          <!-- 4. Call Volume -->
          <h2 class="section-title">4. Call Volume</h2>
          <div class="inline-group">
            <div class="field-group">
              <label for="avg_calls_per_day" class="field-label">Average calls per day</label>
              <input type="text" id="avg_calls_per_day" name="avg_calls_per_day" />
            </div>
            <div class="field-group">
              <label for="avg_calls_per_week" class="field-label">Average calls per week</label>
              <input type="text" id="avg_calls_per_week" name="avg_calls_per_week" />
            </div>
          </div>
          <div class="inline-group">
            <div class="field-group">
              <label for="peak_times" class="field-label">Peak times</label>
              <input type="text" id="peak_times" name="peak_times" placeholder="e.g. Mon morning, lunch time, season" />
            </div>
            <div class="field-group">
              <label for="missed_calls" class="field-label">Missed calls</label>
              <input type="text" id="missed_calls" name="missed_calls" placeholder="Estimate per day/week" />
            </div>
          </div>

          <div class="field-group">
            <span class="field-label">Seasonal fluctuations?</span>
            <div class="inline-group">
              <label class="radio-inline">
                <input type="radio" name="seasonal_fluctuations" value="yes" />
                Yes
              </label>
              <label class="radio-inline">
                <input type="radio" name="seasonal_fluctuations" value="no" />
                No
              </label>
            </div>
          </div>

          <div class="field-group">
            <span class="field-label">Seasonal patterns (if any)</span>
            <div class="checkbox-grid">
              <label class="checkbox-inline">
                <input type="checkbox" name="seasonal_patterns" value="christmas" />
                Christmas
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="seasonal_patterns" value="summer" />
                Summer
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="seasonal_patterns" value="trade_fairs" />
                Trade fairs
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="seasonal_patterns" value="month_end" />
                Month‑end
              </label>
            </div>
          </div>
