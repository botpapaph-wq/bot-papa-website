<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Imprint – BOT PAPA</title>
  <meta name="description" content="Imprint / Legal Notice for BOT PAPA AI phone assistant services." />

  <style>
    :root {
      --bg: #050816;
      --bg-soft: #0b1020;
      --accent: #00e0ff;
      --accent-soft: rgba(0, 224, 255, 0.12);
      --text: #f5f7ff;
      --muted: #a3aac2;
      --danger: #ff4b6b;
      --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.45);
      --radius-lg: 18px;
      --radius-full: 999px;
      --border-soft: 1px solid rgba(255, 255, 255, 0.07);
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
        "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: var(--font-sans);
      background: radial-gradient(circle at top, #101735 0, #050816 55%, #02030a 100%);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .page {
      max-width: 1120px;
      margin: 0 auto;
      padding: 24px 20px 64px;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 16px 12px;
      margin-bottom: 32px;
      border-radius: var(--radius-full);
      border: var(--border-soft);
      background: linear-gradient(135deg, rgba(0, 224, 255, 0.12), transparent);
      backdrop-filter: blur(16px);
      box-shadow: var(--shadow-soft);
      position: sticky;
      top: 16px;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .brand-mark {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }

    .brand-mark img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .brand-text-title {
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-size: 14px;
    }

    .brand-text-sub {
      font-size: 12px;
      color: var(--muted);
    }

    .header-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      flex: 1;
    }

    .header-top-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      width: 100%;
    }

    .pill {
      border-radius: var(--radius-full);
      padding: 6px 14px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border: var(--border-soft);
      color: var(--muted);
      background: rgba(5, 8, 22, 0.9);
      white-space: nowrap;
    }

    .btn-primary {
      border-radius: var(--radius-full);
      padding: 9px 18px;
      border: none;
      outline: none;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      background: linear-gradient(135deg, #00e0ff, #7b3fff);
      color: #050816;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }

    .btn-primary span {
      font-size: 16px;
      transform: translateY(1px);
    }

    .btn-primary:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .btn-primary:active {
      filter: brightness(0.98);
      transform: translateY(0);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.55);
    }

    main {
      margin-top: 12px;
    }

    .content-card {
      padding: 24px 20px 22px;
      border-radius: var(--radius-lg);
      border: var(--border-soft);
      background: linear-gradient(155deg, rgba(8, 13, 34, 0.95), rgba(2, 4, 13, 0.98));
      box-shadow: var(--shadow-soft);
      font-size: 14px;
    }

    .content-card h1 {
      margin-top: 0;
      margin-bottom: 8px;
      font-size: 22px;
    }

    .content-card h2 {
      margin-top: 20px;
      margin-bottom: 6px;
      font-size: 16px;
    }

    .content-card p {
      margin: 0 0 8px;
      color: var(--muted);
      font-size: 13px;
    }

    .content-card ul {
      margin: 4px 0 10px 18px;
      padding: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .content-card li {
      margin-bottom: 4px;
    }

    footer {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 11px;
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: space-between;
      align-items: center;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .footer-links a {
      color: var(--muted);
      text-decoration: none;
    }

    .footer-links a:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      header {
        position: static;
        border-radius: 14px;
        padding: 10px 12px;
      }
      .header-right {
        align-items: flex-start;
      }
      .header-top-row {
        justify-content: flex-start;
        flex-wrap: wrap;
        row-gap: 6px;
      }
      .content-card {
        padding: 20px 16px 18px;
      }
      footer {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
