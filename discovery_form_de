<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>BOT PAPA – Erhebungsformular für KI-Telefonassistent</title>
  <meta name="description" content="Erhebungsformular für KI-Telefonassistenten-Projekte mit BOT PAPA. Strukturierte Erfassung von Anforderungen für KI-gestützte Telefonie, Routing und Automatisierung." />

  <style>
    :root {
      --bg: #050816;
      --bg-soft: #0b1020;
      --accent: #00e0ff;
      --accent-soft: rgba(0, 224, 255, 0.12);
      --text: #f5f7ff;
      --muted: #a3aac2;
      --danger: #ff4b6b;
      --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.45);
      --radius-lg: 18px;
      --radius-full: 999px;
      --border-soft: 1px solid rgba(255, 255, 255, 0.07);
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
        "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: var(--font-sans);
      background: radial-gradient(circle at top, #101735 0, #050816 55%, #02030a 100%);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .page {
      max-width: 1120px;
      margin: 0 auto;
      padding: 24px 20px 64px;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 16px 12px;
      margin-bottom: 32px;
      border-radius: var(--radius-full);
      border: var(--border-soft);
      background: linear-gradient(135deg, rgba(0, 224, 255, 0.12), transparent);
      backdrop-filter: blur(16px);
      box-shadow: var(--shadow-soft);
      position: sticky;
      top: 16px;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .brand-mark {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }

    .brand-mark img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .brand-text-title {
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-size: 14px;
    }

    .brand-text-sub {
      font-size: 12px;
      color: var(--muted);
    }

    .header-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      flex: 1;
    }

    .header-top-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      width: 100%;
    }

    .pill {
      border-radius: var(--radius-full);
      padding: 6px 14px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border: var(--border-soft);
      color: var(--muted);
      background: rgba(5, 8, 22, 0.9);
      white-space: nowrap;
    }

    .btn-primary {
      border-radius: var(--radius-full);
      padding: 9px 18px;
      border: none;
      outline: none;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      background: linear-gradient(135deg, #00e0ff, #7b3fff);
      color: #050816;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }

    .btn-primary span {
      font-size: 16px;
      transform: translateY(1px);
    }

    .btn-primary:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .btn-primary:active {
      filter: brightness(0.98);
      transform: translateY(0);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.55);
    }

    main {
      margin-top: 12px;
    }

    .hero {
      padding: 26px 24px 20px;
      border-radius: var(--radius-lg);
      border: var(--border-soft);
      background: radial-gradient(circle at top left, rgba(0, 224, 255, 0.08), transparent 55%),
        linear-gradient(145deg, rgba(14, 21, 47, 0.95), rgba(3, 5, 16, 0.98));
      box-shadow: var(--shadow-soft);
      margin-bottom: 20px;
    }

    .hero-kicker {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin-bottom: 8px;
    }

    .hero-title {
      font-size: clamp(24px, 2.7vw, 30px);
      line-height: 1.15;
      margin: 0 0 10px;
    }

    .hero-sub {
      font-size: 14px;
      color: var(--muted);
      max-width: 640px;
      margin-bottom: 4px;
    }

    .form-card {
      margin-top: 20px;
      padding: 20px 18px 22px;
      border-radius: var(--radius-lg);
      border: var(--border-soft);
      background: linear-gradient(155deg, rgba(8, 13, 34, 0.95), rgba(2, 4, 13, 0.98));
      box-shadow: var(--shadow-soft);
      font-size: 14px;
    }

    h2.section-title {
      margin: 18px 0 8px;
      font-size: 18px;
    }

    .field-group {
      margin-bottom: 14px;
    }

    .field-label {
      display: block;
      font-size: 13px;
      margin-bottom: 4px;
      color: var(--text);
    }

    .field-help {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }

    input[type="text"],
    input[type="number"],
    input[type="email"],
    textarea,
    select {
      width: 100%;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(3, 6, 20, 0.96);
      color: var(--text);
      font-size: 13px;
      outline: none;
    }

    textarea {
      min-height: 70px;
      resize: vertical;
    }

    input::placeholder,
    textarea::placeholder {
      color: rgba(163, 170, 194, 0.7);
    }

    .checkbox-grid,
    .radio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 6px 18px;
      margin-top: 4px;
    }

    .checkbox-inline,
    .radio-inline {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--muted);
    }

    .inline-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      margin-top: 4px;
    }

    .inline-group .field-group {
      flex: 1;
      min-width: 180px;
      margin-bottom: 0;
    }

    .divider {
      margin: 18px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .tagline {
      font-size: 12px;
      color: var(--muted);
      margin-top: 4px;
    }

    .status-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 12px;
      color: var(--muted);
      margin-top: 16px;
      flex-wrap: wrap;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #20c997;
      margin-right: 6px;
    }

    .status-left {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .status-right {
      text-align: right;
    }

    .status-error {
      color: var(--danger);
    }

    .status-success {
      color: #20c997;
    }

    .submit-row {
      margin-top: 18px;
      display: flex;
      justify-content: flex-end;
    }

    footer {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 11px;
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: space-between;
    }

    @media (max-width: 768px) {
      header {
        position: static;
        border-radius: 14px;
        padding: 10px 12px;
      }
      .header-right {
        align-items: flex-start;
      }
      .header-top-row {
        justify-content: flex-start;
        flex-wrap: wrap;
        row-gap: 6px;
      }
      .hero {
        padding: 22px 18px 18px;
      }
      .status-right {
        text-align: left;
      }
    }
  </style>
<base target="_blank">
</head>
<body>
  <div class="page">
    <header>
      <a href="index.html" class="brand" style="text-decoration: none; color: inherit;">
        <div class="brand-mark">
          <img src="BOT_PAPA-removebg.png" alt="BOT PAPA Logo" />
        </div>
        <div>
          <div class="brand-text-title">BOT PAPA</div>
          <div class="brand-text-sub">KI-Telefonassistenten für kleine Unternehmen</div>
        </div>
      </a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-kicker">KI-Telefonassistent • Erhebungsformular</div>
        <h1 class="hero-title">
          Projekterhebung für Ihre KI-gestützte Telefonie-Einrichtung.
        </h1>
        <p class="hero-sub">
          Dieses Formular erfasst die wichtigsten Details zu Ihrer bestehenden Telefonie-Anlage,
          Anrufabläufen und Rahmenbedingungen – damit wir einen KI-Telefonassistenten
          entwickeln können, der perfekt in Ihren realen Betrieb passt.
        </p>
      </section>

      <section class="form-card">
        <form id="discovery-form">
          <!-- 0. Projektgrundlage / Business Case -->
          <h2 class="section-title">0. Projektgrundlage / Business Case</h2>
          <div class="field-group">
            <span class="field-label">Warum prüft der Kunde gerade jetzt KI-gestützte Telefonie?</span>
            <div class="checkbox-grid">
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="too_many_missed_calls" />
                Zu viele verpasste Anrufe
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="staff_shortage" />
                Personalmangel
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="business_growth" />
                Unternehmenswachstum
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="need_24_7" />
                Bedarf an 24/7-Verfügbarkeit
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="high_support_workload" />
                Hoher Support-Aufwand
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="many_repetitive_inquiries" />
                Viele sich wiederholende Anfragen
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="quality_issues_phone_service" />
                Qualitätsprobleme beim Telefonservice
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="reasons" value="cost_reduction" />
                Kostensenkung
              </label>
            </div>
          </div>

          <div class="field-group">
            <label for="reason_other" class="field-label">Anderer Grund</label>
            <input type="text" id="reason_other" name="reason_other" placeholder="Sonstiges: Kurzbeschreibung" />
          </div>

          <div class="field-group">
            <label for="estimated_monthly_cost" class="field-label">Geschätzte monatliche Kosten des aktuellen Problems</label>
            <input type="text" id="estimated_monthly_cost" name="estimated_monthly_cost" placeholder="Grobe Schätzung in Ihrer Währung" />
          </div>

          <div class="field-group">
            <label for="improvement_goal" class="field-label">Was genau soll sich verbessern?</label>
            <textarea id="improvement_goal" name="improvement_goal" placeholder="Freitext – Beschreiben Sie die praktischen Verbesserungen, die Sie sich wünschen."></textarea>
          </div>

          <div class="divider"></div>

          <!-- 1. Unternehmensinformationen -->
          <h2 class="section-title">1. Unternehmensinformationen</h2>
          <div class="field-group">
            <label for="company_name" class="field-label">Firmenname</label>
            <input type="text" id="company_name" name="company_name" required />
          </div>

          <div class="inline-group">
            <div class="field-group">
              <label for="website" class="field-label">Webseite</label>
              <input type="text" id="website" name="website" />
            </div>
            <div class="field-group">
              <label for="industry" class="field-label">Branche</label>
              <input type="text" id="industry" name="industry" required />
            </div>
          </div>

          <!-- Länderauswahl (Europa exkl. TR/UA/AL + englischsprachig/PH) -->
          <div class="field-group">
            <label for="country" class="field-label">Land</label>
            <select id="country" name="country">
              <option value="">Land auswählen…</option>
              <!-- Europa (Beispiele, ohne TR/UA/AL) -->
              <option value="DE">Deutschland</option>
              <option value="AT">Österreich</option>
              <option value="CH">Schweiz</option>
              <option value="FR">Frankreich</option>
              <option value="IT">Italien</option>
              <option value="ES">Spanien</option>
              <option value="PT">Portugal</option>
              <option value="NL">Niederlande</option>
              <option value="BE">Belgien</option>
              <option value="LU">Luxemburg</option>
              <option value="DK">Dänemark</option>
              <option value="SE">Schweden</option>
              <option value="NO">Norwegen</option>
              <option value="FI">Finnland</option>
              <option value="IS">Island</option>
              <option value="IE">Irland</option>
              <option value="GB">Vereinigtes Königreich</option>
              <option value="PL">Polen</option>
              <option value="CZ">Tschechische Republik</option>
              <option value="SK">Slowakei</option>
              <option value="HU">Ungarn</option>
              <option value="SI">Slowenien</option>
              <option value="HR">Kroatien</option>
              <option value="RS">Serbien</option>
              <option value="BA">Bosnien und Herzegowina</option>
              <option value="MK">Nordmazedonien</option>
              <option value="RO">Rumänien</option>
              <option value="BG">Bulgarien</option>
              <option value="GR">Griechenland</option>
              <option value="CY">Zypern</option>
              <option value="MT">Malta</option>
              <option value="EE">Estland</option>
              <option value="LV">Lettland</option>
              <option value="LT">Litauen</option>

              <!-- Englischsprachig / Englisch offizielle oder ko-offizielle Sprache + PH -->
              <option value="US">Vereinigte Staaten</option>
              <option value="CA">Kanada</option>
              <option value="AU">Australien</option>
              <option value="NZ">Neuseeland</option>
              <option value="ZA">Südafrika</option>
              <option value="PH">Philippinen</option>
              <option value="SG">Singapur</option>
              <option value="IN">Indien</option>
              <option value="PK">Pakistan</option>
              <option value="NG">Nigeria</option>
              <option value="GH">Ghana</option>
              <option value="KE">Kenia</option>
              <option value="TZ">Tansania</option>
              <option value="UG">Uganda</option>
              <option value="ZW">Simbabwe</option>
              <option value="JM">Jamaika</option>
              <option value="TT">Trinidad und Tobago</option>
              <option value="BB">Barbados</option>
              <option value="BS">Bahamas</option>
              <option value="BZ">Belize</option>
              <option value="FJ">Fidschi</option>
              <option value="PG">Papua-Neuguinea</option>
            </select>
          </div>

          <!-- Rechnungs- / Firmenadresse -->
          <div class="inline-group">
            <div class="field-group" style="flex:2">
              <label for="address_street" class="field-label">Straße</label>
              <input type="text" id="address_street" name="address_street" required placeholder="Straßenname" />
            </div>
            <div class="field-group" style="flex:0.6">
              <label for="address_number" class="field-label">Nr.</label>
              <input type="text" id="address_number" name="address_number" placeholder="12a" />
            </div>
          </div>

          <div class="inline-group">
            <div class="field-group" style="flex:0.8">
              <label for="address_zip" class="field-label">PLZ</label>
              <input type="text" id="address_zip" name="address_zip" required placeholder="z. B. 10115" />
            </div>
            <div class="field-group" style="flex:2">
              <label for="address_city" class="field-label">Stadt</label>
              <input type="text" id="address_city" name="address_city" required placeholder="z. B. Berlin" />
            </div>
            <div class="field-group" style="flex:1.5">
              <label for="address_state" class="field-label">Bundesland / Region</label>
              <input type="text" id="address_state" name="address_state" placeholder="z. B. Bayern" />
            </div>
          </div>

          <div class="inline-group">
            <div class="field-group">
              <label for="num_employees" class="field-label">Anzahl der Mitarbeiter</label>
              <input type="text" id="num_employees" name="num_employees" />
            </div>
          </div>

          <div class="inline-group">
            <div class="field-group">
              <label for="phone_contacts" class="field-label">Telefonische Ansprechpartner</label>
              <input type="text" id="phone_contacts" name="phone_contacts" placeholder="Wie viele Personen nehmen Anrufe entgegen?" />
            </div>
            <div class="field-group">
              <label for="business_hours" class="field-label">Öffnungszeiten</label>
              <input type="text" id="business_hours" name="business_hours" placeholder="z. B. Mo–Fr 8:00–17:00 Ortszeit" />
            </div>
          </div>

          <!-- Kunden-Telefon & E-Mail -->
          <div class="inline-group">
            <div class="field-group">
              <label for="phone_country_code" class="field-label">Länderkennzahl Kundennummer</label>
              <select id="phone_country_code" name="phone_country_code">
                <option value="">Kennzahl auswählen…</option>
                <option value="+49">+49 (Deutschland)</option>
                <option value="+43">+43 (Österreich)</option>
                <option value="+41">+41 (Schweiz)</option>
                <option value="+33">+33 (Frankreich)</option>
                <option value="+39">+39 (Italien)</option>
                <option value="+34">+34 (Spanien)</option>
                <option value="+351">+351 (Portugal)</option>
                <option value="+31">+31 (Niederlande)</option>
                <option value="+32">+32 (Belgien)</option>
                <option value="+44">+44 (Vereinigtes Königreich)</option>
                <option value="+1">+1 (USA/Kanada)</option>
                <option value="+61">+61 (Australien)</option>
                <option value="+64">+64 (Neuseeland)</option>
                <option value="+27">+27 (Südafrika)</option>
                <option value="+63">+63 (Philippinen)</option>
                <option value="+65">+65 (Singapur)</option>
                <option value="+91">+91 (Indien)</option>
                <option value="+92">+92 (Pakistan)</option>
                <option value="+234">+234 (Nigeria)</option>
                <option value="+233">+233 (Ghana)</option>
                <option value="+254">+254 (Kenia)</option>
                <option value="+255">+255 (Tansania)</option>
                <option value="+256">+256 (Uganda)</option>
              </select>
            </div>
            <div class="field-group">
              <label for="phone_number_customer" class="field-label">Kundennummer</label>
              <input type="text" id="phone_number_customer" name="phone_number_customer" required placeholder="Ortsnummer ohne Länderkennzahl" />
            </div>
          </div>

          <div class="field-group">
            <label for="customer_email" class="field-label">Kunden-E-Mail</label>
            <input
              type="email"
              id="customer_email"
              name="customer_email"
              placeholder="name@firma.de"
              pattern="^(?!info@).*"
              required
              title="Bitte verwenden Sie eine persönliche oder rollenspezifische E-Mail, keine generische info@-Adresse."
            />
            <div class="field-help">
              Generische Postfächer wie <code>info@</code> werden oft nicht regelmäßig geprüft. Bitte verwenden Sie eine persönliche oder rollenspezifische Adresse.
            </div>
          </div>

          <div class="divider"></div>

          <!-- 2. Projektbeteiligte -->
          <h2 class="section-title">2. Projektbeteiligte</h2>
          <div class="field-group">
            <label for="technical_contact" class="field-label">Technischer Ansprechpartner</label>
            <input type="text" id="technical_contact" name="technical_contact" placeholder="Name, Funktion, E-Mail/Telefon falls hilfreich" />
          </div>
          <div class="field-group">
            <label for="operational_contact" class="field-label">Operativer Ansprechpartner</label>
            <input type="text" id="operational_contact" name="operational_contact" placeholder="Person, die für den täglichen Telefonie-Betrieb zuständig ist" />
          </div>
          <div class="field-group">
            <label for="commercial_decision_maker" class="field-label">Wirtschaftlicher Entscheidungsträger</label>
            <input type="text" id="commercial_decision_maker" name="commercial_decision_maker" />
          </div>
          <div class="field-group">
            <span class="field-label">Ist das Management involviert?</span>
            <div class="inline-group">
              <label class="radio-inline">
                <input type="radio" name="management_involved" value="yes" />
                Ja
              </label>
              <label class="radio-inline">
                <input type="radio" name="management_involved" value="no" />
                Nein
              </label>
            </div>
          </div>
          <div class="field-group">
            <label for="final_approval" class="field-label">Wer gibt die finale Freigabe?</label>
            <input type="text" id="final_approval" name="final_approval" />
          </div>

          <div class="divider"></div>

          <!-- 3. Bestehende Telefonie-Anlage -->
          <h2 class="section-title">3. Bestehende Telefonie-Anlage</h2>
          <div class="field-group">
            <label for="current_phone_system" class="field-label">Aktuelles Telefonsystem</label>
            <input type="text" id="current_phone_system" name="current_phone_system" placeholder="z. B. Telnyx, Placetel, andere TK-Anlage" />
          </div>
          <div class="field-group">
            <span class="field-label">Bestehende Elemente</span>
            <div class="checkbox-grid">
              <label class="checkbox-inline">
                <input type="checkbox" name="telephony_elements" value="main_company_number" />
                Hauptnummer vorhanden
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="telephony_elements" value="extensions" />
                Durchwahlen vorhanden
              </label>
              <label class="checkbox-inline">
                <input type="checkbox" name="telephony_elements" value="call_groups" />
                Rufgruppen vorhanden
              </label>
              <label class="checkbox-inline">
